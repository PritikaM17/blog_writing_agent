# Copy this file to .env and fill in your own keys.
# .env is git-ignored, so your keys stay on your machine.

# Required
OPENAI_API_KEY=      # the AI that routes, plans and writes (gpt-4.1-mini)
TAVILY_API_KEY=      # web search for topics that need fresh information
GOOGLE_API_KEY=      # Gemini, for the blog images

# Optional: LangSmith tracing, to see each node's run
LANGSMITH_TRACING_V2=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=blog-writing-agent
